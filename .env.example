# Copy this file to .env and fill in your own values.
# Never commit .env to version control.

# Frankfurter API (free, no key required for basic use)
API_URL=https://api.frankfurter.dev/v1/latest
API_KEY=

# Currencies to fetch
BASE_CURRENCY=USD
TARGET_CURRENCIES=EUR,GBP,JPY,KES

# Retry settings
MAX_ATTEMPTS=3
WAIT_SECONDS=2

# PostgreSQL connection (individual settings)
PGHOST=localhost
PGPORT=5432
PGDATABASE=rica
PGUSER=postgres
PGPASSWORD=

# Or use a single connection string instead of the above
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
